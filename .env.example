# Configure in the process environment or a protected service EnvironmentFile.
# There is deliberately no default account or password.
PANEL_USERNAME=
# At least 12 characters; use a generated unique password (prefer 32+).
PANEL_PASSWORD=
# Canonical public HTTPS origin, for example https://competition.example.org
PUBLIC_ORIGIN=
# Optional server-owned paths; keep these outside the public assets directory.
# LEADERBOARD_DB=/var/lib/ceva/leaderboard.sqlite3
# LEADERBOARD_BACKUP_DIR=/var/lib/ceva/backups
# BACKUP_TIMEZONE=Europe/Berlin
